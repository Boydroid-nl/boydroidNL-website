---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { type Lang, routes, useTranslations } from '../i18n';

interface Props {
  lang: Lang;
  title?: string;
  description: string;
  /** Path of this page in the other language, for the language switch and hreflang. Omit for single-language pages. */
  alternate?: string;
}

const { lang, title, description, alternate } = Astro.props;
const t = useTranslations(lang);
const fullTitle = title ? `${title} | Boydroid` : 'Boydroid | App development';
const canonical = new URL(Astro.url.pathname, Astro.site);
const altLang: Lang = lang === 'nl' ? 'en' : 'nl';
const altUrl = alternate ? new URL(alternate, Astro.site) : undefined;
const nlUrl = lang === 'nl' ? canonical : altUrl;
const ogImage = new URL('/apple-touch-icon.png', Astro.site);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {
      altUrl && (
        <>
          <link rel="alternate" hreflang={lang} href={canonical} />
          <link rel="alternate" hreflang={altLang} href={altUrl} />
          <link rel="alternate" hreflang="x-default" href={nlUrl} />
        </>
      )
    }
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0f1115" media="(prefers-color-scheme: dark)" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Boydroid" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={lang === 'nl' ? 'nl_NL' : 'en_US'} />
    <meta name="generator" content={Astro.generator} />
    <script is:inline>
      // Apply the saved theme before first paint to avoid a flash.
      (function () {
        var pref = 'system';
        try {
          var saved = localStorage.getItem('theme');
          if (saved === 'light' || saved === 'dark') pref = saved;
        } catch (e) {}
        var root = document.documentElement;
        root.classList.add('js'); // enables scroll-reveal styles
        root.dataset.themePref = pref;
        if (pref !== 'system') root.dataset.theme = pref;
      })();
    </script>
  </head>
  <body class="flex min-h-screen flex-col">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:rounded-full focus:bg-primary focus:px-4 focus:py-2 focus:text-primary-contrast"
    >
      {t('nav.skip')}
    </a>
    <Header lang={lang} alternate={alternate ?? routes.home[altLang]} />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer lang={lang} />
    <script>
      // Fade elements with [data-reveal] in when they scroll into view.
      // Children of [data-reveal-stagger] get an increasing delay.
      document.querySelectorAll<HTMLElement>('[data-reveal-stagger]').forEach((group) => {
        group.querySelectorAll<HTMLElement>(':scope > [data-reveal]').forEach((el, i) => {
          el.style.setProperty('--reveal-delay', `${Math.min(i, 6) * 90}ms`);
        });
      });
      // Whatever is already on screen at load is shown right away, so a new page doesn't wait on the fade.
      const items = [...document.querySelectorAll<HTMLElement>('[data-reveal]')].filter((el) => {
        if (el.getBoundingClientRect().top >= window.innerHeight) return true;
        el.classList.add('is-visible', 'no-reveal-transition');
        return false;
      });
      if (!('IntersectionObserver' in window)) {
        items.forEach((el) => el.classList.add('is-visible'));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.classList.add('is-visible');
              io.unobserve(entry.target);
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.1 },
        );
        items.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>
