---
import Base from '../layouts/Base.astro';
import { routes, ui } from '../i18n';
---

<Base lang="nl" title={ui.nl['notfound.title']} description={ui.nl['notfound.text']}>
  <section class="container-page py-24 text-center">
    <p class="text-6xl font-bold text-primary">404</p>
    <h1 class="mt-4 text-3xl font-bold tracking-tight">{ui.nl['notfound.title']}</h1>
    <p class="mt-3 text-muted">{ui.nl['notfound.text']}</p>
    <p class="mt-1 text-sm text-muted" lang="en">{ui.en['notfound.text']}</p>
    <div class="mt-8 flex justify-center gap-3">
      <a href={routes.home.nl} class="btn-primary">{ui.nl['notfound.home']}</a>
      <a href={routes.home.en} class="btn-secondary" lang="en">{ui.en['notfound.home']}</a>
    </div>
  </section>
</Base>
