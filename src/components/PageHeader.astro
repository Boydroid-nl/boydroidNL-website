---
interface Props {
  eyebrow?: string;
  title: string;
  intro?: string;
}
const { eyebrow, title, intro } = Astro.props;
---

<section class="relative overflow-x-clip">
  <div class="bg-wash absolute inset-0" aria-hidden="true"></div>
  <div class="container-page relative pt-12 pb-10 md:pt-20">
    {eyebrow && <p class="eyebrow" data-reveal>{eyebrow}</p>}
    <h1 class="mt-3 max-w-3xl text-4xl font-bold tracking-tight sm:text-5xl" data-reveal style="--reveal-delay: 80ms">
      {title}
    </h1>
    {
      intro && (
        <p class="mt-6 max-w-2xl text-lg leading-relaxed text-muted" data-reveal style="--reveal-delay: 160ms">
          {intro}
        </p>
      )
    }
    <slot />
  </div>
</section>
