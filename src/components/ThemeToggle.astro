---
import { type Lang, useTranslations } from '../i18n';

interface Props {
  lang: Lang;
}
const t = useTranslations(Astro.props.lang);
---

<button
  type="button"
  class="theme-toggle inline-flex size-9 items-center justify-center rounded-md text-muted transition-colors hover:bg-surface hover:text-text"
  aria-label={t('theme.toggle')}
  data-labels={JSON.stringify({ system: t('theme.system'), light: t('theme.light'), dark: t('theme.dark') })}
>
  <!-- system -->
  <svg class="icon-system size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
    <rect x="3" y="4" width="18" height="12" rx="2"></rect><path d="M8 20h8M12 16v4"></path>
  </svg>
  <!-- light -->
  <svg class="icon-light size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
  </svg>
  <!-- dark -->
  <svg class="icon-dark size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
    <path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5Z"></path>
  </svg>
</button>

<style>
  .theme-toggle svg {
    display: none;
  }
  :global(html:not([data-theme-pref])) .theme-toggle .icon-system,
  :global(html[data-theme-pref='system']) .theme-toggle .icon-system,
  :global(html[data-theme-pref='light']) .theme-toggle .icon-light,
  :global(html[data-theme-pref='dark']) .theme-toggle .icon-dark {
    display: block;
  }
</style>

<script>
  const order = ['system', 'light', 'dark'] as const;
  type Pref = (typeof order)[number];

  function apply(pref: Pref) {
    const root = document.documentElement;
    root.dataset.themePref = pref;
    if (pref === 'system') delete root.dataset.theme;
    else root.dataset.theme = pref;
    try {
      if (pref === 'system') localStorage.removeItem('theme');
      else localStorage.setItem('theme', pref);
    } catch {}
  }

  document.querySelectorAll<HTMLButtonElement>('.theme-toggle').forEach((btn) => {
    const labels = JSON.parse(btn.dataset.labels ?? '{}') as Record<Pref, string>;
    const sync = () => {
      const pref = (document.documentElement.dataset.themePref as Pref) ?? 'system';
      btn.title = labels[pref];
    };
    sync();
    btn.addEventListener('click', () => {
      const current = (document.documentElement.dataset.themePref as Pref) ?? 'system';
      apply(order[(order.indexOf(current) + 1) % order.length]);
      sync();
    });
  });
</script>
