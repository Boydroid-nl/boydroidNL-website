---
import { type Lang, useTranslations } from '../i18n';

interface Props {
  lang: Lang;
  playStore?: string;
  appStore?: string;
}
const { lang, playStore, appStore } = Astro.props;
const t = useTranslations(lang);
---

{
  (playStore || appStore) && (
    <div class="flex flex-wrap gap-3">
      {playStore && (
        <a href={playStore} class="btn-secondary" rel="noopener" target="_blank">
          <svg class="size-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M4 2.5v19a1 1 0 0 0 1.5.86l16.2-9.5a1 1 0 0 0 0-1.72L5.5 1.64A1 1 0 0 0 4 2.5Z" />
          </svg>
          {t('store.play')}
        </a>
      )}
      {appStore && (
        <a href={appStore} class="btn-secondary" rel="noopener" target="_blank">
          <svg class="size-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M16.4 12.6c0-2.4 2-3.6 2.1-3.6a4.6 4.6 0 0 0-3.6-2c-1.5-.2-3 .9-3.7.9-.8 0-2-.9-3.2-.9a4.8 4.8 0 0 0-4 2.5c-1.7 3-.4 7.4 1.2 9.8.8 1.2 1.8 2.5 3 2.4 1.2 0 1.7-.8 3.1-.8 1.5 0 1.9.8 3.2.8s2.1-1.2 2.9-2.4a10 10 0 0 0 1.3-2.7 4.2 4.2 0 0 1-2.3-4ZM14 5.4A4.3 4.3 0 0 0 15 2.2a4.4 4.4 0 0 0-2.9 1.5 4.1 4.1 0 0 0-1 3.1A3.6 3.6 0 0 0 14 5.4Z" />
          </svg>
          {t('store.apple')}
        </a>
      )}
    </div>
  )
}
