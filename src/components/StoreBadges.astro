---
import { type Lang, useTranslations } from '../i18n';
import GooglePlayIcon from '../assets/stores/google-play.svg';
import AppleIcon from '../assets/stores/apple.svg';

interface Props {
  lang: Lang;
  playStore?: string;
  appStore?: string;
}
const { lang, playStore, appStore } = Astro.props;
const t = useTranslations(lang);
---

{
  (playStore || appStore) && (
    <div class="flex flex-wrap gap-3">
      {playStore && (
        <a href={playStore} class="btn-secondary" rel="noopener" target="_blank">
          <GooglePlayIcon class="size-4" aria-hidden="true" />
          {t('store.play')}
        </a>
      )}
      {appStore && (
        <a href={appStore} class="btn-secondary" rel="noopener" target="_blank">
          <AppleIcon class="size-4" aria-hidden="true" />
          {t('store.apple')}
        </a>
      )}
    </div>
  )
}
