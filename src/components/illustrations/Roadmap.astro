---
// Decorative roadmap: a rising line through the goals, from idea to launch.
interface Props {
  steps: string[];
}
const { steps } = Astro.props;

const nodes = [
  { x: 80, y: 310 },
  { x: 240, y: 250 },
  { x: 400, y: 175 },
  { x: 560, y: 90 },
];
---

<svg viewBox="0 0 640 400" class="h-full w-full overflow-visible" role="img" aria-label={`Roadmap: ${steps.join(', ')}`}>
  <defs>
    <linearGradient id="rm-brand" x1="0" y1="1" x2="1" y2="0">
      <stop offset="0" style="stop-color: var(--brand-blue)" />
      <stop offset="0.55" style="stop-color: var(--brand-cyan)" />
      <stop offset="1" style="stop-color: var(--brand-mint)" />
    </linearGradient>
  </defs>

  <path
    d="M80 310 C 160 310, 180 260, 240 250 S 340 190, 400 175 S 510 100, 560 90"
    fill="none"
    stroke="url(#rm-brand)"
    stroke-width="5"
    stroke-linecap="round"
    class="route"
  />

  <line x1="560" y1="90" x2="560" y2="36" class="stroke-text" stroke-width="2.5" stroke-linecap="round" />
  <path d="M561 37 h32 l-8 10 l8 10 h-32 Z" fill="url(#rm-brand)" />

  {
    nodes.map((n, i) => (
      <g>
        <circle cx={n.x} cy={n.y} r="12" class="fill-bg" stroke="url(#rm-brand)" stroke-width="4" />
        <circle cx={n.x} cy={n.y} r="4.5" class={i === nodes.length - 1 ? 'fill-accent-3' : 'fill-primary'} />
        <text x={n.x} y={n.y + 40} text-anchor="middle" class="fill-primary" font-size="13" font-weight="700">
          {String(i + 1).padStart(2, '0')}
        </text>
        <text x={n.x} y={n.y + 60} text-anchor="middle" class="fill-text" font-size="16" font-weight="600">
          {steps[i]}
        </text>
      </g>
    ))
  }
</svg>

<style>
  .route {
    stroke-dasharray: 600;
    stroke-dashoffset: 0;
    animation: draw 2.4s cubic-bezier(0.4, 0, 0.2, 1) both;
  }
  @keyframes draw {
    from {
      stroke-dashoffset: 600;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .route {
      animation: none;
    }
  }
</style>
