---
// Decorative code editor with a bit of Flutter/Dart. Colours follow the theme tokens.
type Token = [text: string, cls?: string];

const kw = 'fill-accent-1';
const type = 'fill-accent-2';
const str = 'fill-accent-3';
const dim = 'fill-muted';

const lines: Token[][] = [
  [['import ', kw], ["'package:flutter/material.dart'", str], [';', dim]],
  [],
  [['void ', kw], ['main() => runApp('], ['const ', kw], ['YourApp', type], ['());', dim]],
  [],
  [['class ', kw], ['YourApp ', type], ['extends ', kw], ['StatelessWidget ', type], ['{', dim]],
  [['  const ', kw], ['YourApp', type], ['({'], ['super', kw], ['.key});']],
  [],
  [['  @override', dim]],
  [['  Widget ', type], ['build('], ['BuildContext ', type], ['context) {']],
  [['    return ', kw], ['MaterialApp', type], ['(']],
  [['      title: '], ["'Your App'", str], [',', dim]],
  [['      home: '], ['const ', kw], ['HomeScreen', type], ['(),', dim]],
  [['    );', dim]],
  [['  }', dim]],
  [['}', dim]],
];

const files = [
  { name: 'main.dart', active: true },
  { name: 'home_screen.dart' },
  { name: 'app_theme.dart' },
];

const top = 82;
const step = 19;
const activeLine = 9;
---

<svg viewBox="0 0 640 400" class="h-full w-full overflow-visible" role="img" aria-label="Code editor with Flutter code">
  <defs>
    <clipPath id="ce-window">
      <rect x="20" y="20" width="600" height="360" rx="12" />
    </clipPath>
  </defs>

  <g class="drop">
    <rect x="20" y="20" width="600" height="360" rx="12" class="fill-bg stroke-border" stroke-width="1" />
  </g>

  <g clip-path="url(#ce-window)">
    <!-- Title bar -->
    <rect x="20" y="20" width="600" height="36" class="fill-surface" />
    <line x1="20" y1="56" x2="620" y2="56" class="stroke-border" />
    <circle cx="40" cy="38" r="5" class="fill-brand-blue" />
    <circle cx="57" cy="38" r="5" class="fill-brand-cyan" />
    <circle cx="74" cy="38" r="5" class="fill-brand-mint" />
    <text x="320" y="42" text-anchor="middle" class="fill-muted" font-size="11">your_app — main.dart</text>

    <!-- Sidebar -->
    <rect x="20" y="56" width="140" height="324" class="fill-surface" />
    <line x1="160" y1="56" x2="160" y2="380" class="stroke-border" />
    <text x="34" y="78" class="fill-muted" font-size="9" font-weight="600" letter-spacing="1">EXPLORER</text>
    <path d="M34 92 l4 4 l4 -4" class="stroke-muted" fill="none" stroke-width="1.5" stroke-linecap="round" />
    <text x="48" y="99" class="fill-text" font-size="11">lib</text>
    {
      files.map((f, i) => (
        <g>
          {f.active && <rect x="26" y={106 + i * 22} width="128" height="20" rx="5" class="fill-primary-soft" />}
          <rect x="48" y={111 + i * 22} width="10" height="10" rx="2.5" class="fill-accent-2" />
          <text x="64" y={120 + i * 22} class={f.active ? 'fill-primary' : 'fill-text'} font-size="11" font-weight={f.active ? 600 : 400}>
            {f.name}
          </text>
        </g>
      ))
    }
    <rect x="34" y="181" width="10" height="10" rx="2.5" class="fill-accent-3" />
    <text x="50" y="190" class="fill-text" font-size="11">pubspec.yaml</text>

    <!-- Code -->
    <rect x="160" y={top - 14 + activeLine * step} width="460" height={step} class="fill-primary-soft" />
    <g font-family="ui-monospace, SFMono-Regular, Menlo, Consolas, monospace" font-size="12.5" xml:space="preserve">
      {
        lines.map((tokens, i) => (
          <g>
            <text x="192" y={top + i * step} text-anchor="end" class="fill-muted" opacity="0.6">{i + 1}</text>
            <text x="206" y={top + i * step} class="fill-text whitespace-pre">
              {tokens.map(([t, cls]) => <tspan class={cls}>{t}</tspan>)}
            </text>
          </g>
        ))
      }
    </g>
    <rect x="382" y={top - 11 + activeLine * step} width="2" height="14" class="fill-primary cursor" />
  </g>
</svg>

<style>
  .drop {
    filter: drop-shadow(0 14px 24px color-mix(in srgb, var(--primary) 18%, transparent));
  }
  .cursor {
    animation: blink 1.1s steps(1) infinite;
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .cursor {
      animation: none;
    }
  }
</style>
