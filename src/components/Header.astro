---
import Logo from './Logo.astro';
import ThemeToggle from './ThemeToggle.astro';
import { type Lang, contact, nav, routes, useTranslations } from '../i18n';

interface Props {
  lang: Lang;
  alternate: string;
}
const { lang, alternate } = Astro.props;
const t = useTranslations(lang);
const current = Astro.url.pathname.replace(/\/?$/, '/');
const isActive = (href: string) =>
  href === routes.home[lang] ? current === href : current.startsWith(href);
const items = nav.map((key) => ({ href: routes[key][lang], label: t(`nav.${key}`) }));
const otherLang = lang === 'nl' ? 'EN' : 'NL';
const otherLangName = lang === 'nl' ? 'English' : 'Nederlands';
---

<header class="site-header sticky top-0 z-40 border-b border-border bg-bg/80 backdrop-blur-md">
  <div class="container-page flex h-20 items-center justify-between gap-4">
    <a href={routes.home[lang]} class="shrink-0 text-text" aria-label="Boydroid home">
      <Logo height={46} class="transition-opacity hover:opacity-80" />
    </a>

    <!-- Desktop nav: the current page is a filled button -->
    <nav class="hidden lg:block" aria-label={lang === 'nl' ? 'Hoofdmenu' : 'Main menu'}>
      <ul class="flex items-center gap-1">
        {
          items.map((item) => (
            <li>
              <a
                href={item.href}
                class:list={[
                  'block rounded-lg px-3.5 py-2 text-sm font-medium transition-all duration-200',
                  isActive(item.href)
                    ? 'nav-current bg-gradient-button text-white'
                    : 'text-muted hover:bg-surface hover:text-text',
                ]}
                aria-current={isActive(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-1.5">
      <a
        href={alternate}
        hreflang={lang === 'nl' ? 'en' : 'nl'}
        class="inline-flex h-9 items-center rounded-lg border border-border px-2.5 text-xs font-semibold text-muted transition-colors hover:border-primary hover:text-primary"
        aria-label={otherLangName}
        title={otherLangName}
      >
        {otherLang}
      </a>
      <ThemeToggle lang={lang} />
      <a href={`mailto:${contact.appEmail}`} class="btn-primary ml-1.5 hidden !py-2 sm:inline-flex">
        {t('cta.app')}
      </a>

      <details class="group relative lg:hidden">
        <summary
          class="inline-flex size-9 cursor-pointer list-none items-center justify-center rounded-lg border border-border text-text hover:border-primary hover:text-primary [&::-webkit-details-marker]:hidden"
          aria-label={t('nav.menu')}
        >
          <svg class="size-5 group-open:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M4 7h16M4 12h16M4 17h16"></path>
          </svg>
          <svg class="hidden size-5 group-open:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M6 6l12 12M18 6 6 18"></path>
          </svg>
        </summary>
        <nav
          class="absolute right-0 mt-3 w-60 rounded-xl border border-border bg-bg p-1.5 shadow-xl"
          aria-label={t('nav.menu')}
        >
          <ul class="space-y-0.5">
            {
              items.map((item) => (
                <li>
                  <a
                    href={item.href}
                    class:list={[
                      'block rounded-lg px-3 py-2.5 text-sm font-medium transition-colors',
                      isActive(item.href) ? 'nav-current bg-gradient-button text-white' : 'text-text hover:bg-surface',
                    ]}
                    aria-current={isActive(item.href) ? 'page' : undefined}
                  >
                    {item.label}
                  </a>
                </li>
              ))
            }
            <li class="pt-1.5 sm:hidden">
              <a href={`mailto:${contact.appEmail}`} class="btn-primary w-full">{t('cta.app')}</a>
            </li>
          </ul>
        </nav>
      </details>
    </div>
  </div>
</header>

<style>
  .nav-current {
    box-shadow:
      0 6px 16px -6px color-mix(in srgb, var(--brand-blue) 60%, transparent),
      inset 0 1px 0 rgb(255 255 255 / 0.25);
    text-shadow: 0 1px 1px rgb(0 0 0 / 0.12);
  }
  /* Slightly stronger shadow once the page is scrolled */
  .site-header {
    transition: box-shadow 0.3s;
  }
  :global(html.scrolled) .site-header {
    box-shadow: 0 8px 24px -16px rgb(0 0 0 / 0.25);
  }
</style>

<script>
  const onScroll = () => document.documentElement.classList.toggle('scrolled', window.scrollY > 8);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
</script>
